# 통합 DB 모니터링 시스템 환경 변수 템플릿
# 실제 값은 .env.local 또는 배포 환경의 Secret Manager에 설정합니다.
# 비밀번호, token, connection string은 Git에 커밋하지 않습니다.

# -----------------------------------------------------------------------------
# App / Runtime
# -----------------------------------------------------------------------------
APP_ENV=development
NEXT_PUBLIC_APP_NAME="통합 DB 모니터링"
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Supabase (레거시 — MSSQL 전환 후 제거 가능)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# -----------------------------------------------------------------------------
# MSSQL / 앱 운영 DB
# -----------------------------------------------------------------------------
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=false
# trustServerCertificate=false 일 때 certs/corp-ca.pem 자동 로드
MSSQL_CA_CERT_PATH=

# Secret 저장소: db_encrypted(MSSQL 암호화) | supabase_vault | env_local(개발/env: ref)
SECRET_PROVIDER=db_encrypted
SECRET_KEY_PREFIX=dbmonitoring
# db_encrypted 사용 시 필수 — openssl rand -base64 32 로 생성
SECRET_ENCRYPTION_KEY=
# MSSQL migration: npm run db:migrate

# -----------------------------------------------------------------------------
# SSO / Auth (T-009)
# -----------------------------------------------------------------------------
SSO_PROVIDER=mock
SSO_ISSUER_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_CALLBACK_URL=http://localhost:3000/api/auth/callback
AUTH_SESSION_SECRET=
AUTH_COOKIE_NAME=dbmonitoring_session

# -----------------------------------------------------------------------------
# ERP 테스트 DB / 개발용 연결 확인 API
# -----------------------------------------------------------------------------
ERP_TEST_DB_HOST=
ERP_TEST_DB_PORT=1433
ERP_TEST_DB_NAME=
ERP_TEST_DB_USER=
ERP_TEST_DB_PASSWORD=
ERP_TEST_DB_ENCRYPT=true
ERP_TEST_DB_TRUST_SERVER_CERTIFICATE=true
ERP_TEST_DB_CONNECTION_TIMEOUT_MS=5000
ERP_TEST_DB_REQUEST_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# Collector / Worker (T-014~T-016)
# -----------------------------------------------------------------------------
COLLECTOR_ID=local-dev-collector
COLLECTOR_DEFAULT_INTERVAL_SEC=30
COLLECTOR_SQL_AGGREGATE_INTERVAL_SEC=300

# -----------------------------------------------------------------------------
# Notification (T-024)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TEAMS_WEBHOOK_URL=
