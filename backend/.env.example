APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO
NEXT_LEGACY_BASE_URL=http://127.0.0.1:3000

# Next(AS-IS) 또는 동일 운영 DB (R1 이관 시)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Next .env.local과 공유 시
NEXT_PUBLIC_SUPABASE_URL=

# MSSQL 운영 DB (AS-IS와 동일 변수)
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=false
MSSQL_CA_CERT_PATH=../certs/corp-ca.pem
COLLECTOR_SCHEDULER_DISABLED=false
# env | db_encrypted | supabase_vault (vault ref 시 db_encrypted 이상)
SECRET_PROVIDER=env
SECRET_ENCRYPTION_KEY=

# 수집 대상 A → connectionSecretRef: env:ERP_PROD_DB
# ERP_PROD_DB_HOST=
# ERP_PROD_DB_PORT=1433
# ERP_PROD_DB_DATABASE=
# ERP_PROD_DB_USER=
# ERP_PROD_DB_PASSWORD=

# 수집 대상 B → connectionSecretRef: env:GW_MSSQL
# GW_MSSQL_HOST=
# GW_MSSQL_PORT=1433
# GW_MSSQL_DATABASE=
# GW_MSSQL_USER=
# GW_MSSQL_PASSWORD=